GNSS_DB_HOST=10.20.38.240
GNSS_DB_PORT=5432
GNSS_DB_NAME=sensors_db
GNSS_DB_USER=iris_user
GNSS_DB_PASSWORD=CHANGE_ME

GNSS_APP_HOST=0.0.0.0
GNSS_APP_PORT=8050
GNSS_APP_TITLE=GNSS Live & Historie

GNSS_LIVE_MINUTES=5
GNSS_LIVE_REFRESH_MS=1000
GNSS_MAX_HISTORY_HOURS=48
GNSS_MAX_POINTS_PER_VEHICLE=12000
GNSS_MAX_INCREMENTAL_ROWS=5000
LOG_LEVEL=INFO

# Schalter fuer den Achsen-Layer
GNSS_AXES_VISIBLE=true
GNSS_AXES_GEOJSON=axes.geojson
GNSS_AXES_WIDTH_M=24

# Alternative zu einer vollstaendigen axes.geojson:
# WGS84-Mittelpunkte der Achsen A und L eintragen. Die Zwischenachsen werden
# mit den Achsabstaenden aus dem Plan erzeugt (A, B, C, D, E, F, G, H, J, K, L).
# GNSS_AXIS_A_LAT=51.xxxxxxxx
# GNSS_AXIS_A_LON=13.xxxxxxxx
# GNSS_AXIS_L_LAT=51.xxxxxxxx
# GNSS_AXIS_L_LON=13.xxxxxxxx
