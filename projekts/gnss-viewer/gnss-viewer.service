[Unit]
Description=GNSS PostgreSQL Web Viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/gnss-viewer
EnvironmentFile=/home/user/gnss-viewer/gnss-viewer.env
ExecStart=/home/user/gnss-viewer/venv/bin/gunicorn --workers 2 --threads 4 --timeout 120 --bind 0.0.0.0:8050 gnss_postgres_server:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
