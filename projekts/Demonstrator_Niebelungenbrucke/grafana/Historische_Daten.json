    "panel-10": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "",
        "id": 10,
        "links": [],
        "title": "",
        "vizConfig": {
          "group": "text",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {},
              "overrides": []
            },
            "options": {
              "code": {
                "language": "plaintext",
                "showLineNumbers": false,
                "showMiniMap": false
              },
              "content": "<div style=\"font-family: Arial, sans-serif; font-size: 13px; line-height: 1.5; color: #d8d9da;\">\n\n  <h3 style=\"margin-top:0;\">Alpha-Filter (EMA)</h3>\n\n  <p>\n    Digitaler Tiefpassfilter zur Glättung von Messrauschen.\n    Der Filter basiert auf einem Exponential Moving Average (EMA)\n    und beeinflusst nur den gefilterten Messwert.\n  </p>\n\n  <ul>\n    <li><b>α = 1.0</b> → Filter deaktiviert (Ausgang = Eingang)</li>\n    <li><b>α = 0.1 – 0.5</b> → leichte Glättung</li>\n    <li><b>α = 0.01 – 0.1</b> → starke Glättung</li>\n    <li><b>α = 0.001 – 0.01</b> → sehr starke Glättung für langsam veränderliche Signale</li>\n  </ul>\n\n  <p>\n    Kleinere Alpha-Werte reduzieren das Rauschen stärker,\n    erhöhen jedoch die Reaktionszeit auf tatsächliche Signaländerungen.\n  </p>\n\n</div>",
              "mode": "html"
            }
          },
          "version": "13.0.2"
        }
      }
    },
