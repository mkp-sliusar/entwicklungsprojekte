    "panel-4": { "kind": "Panel", "spec": { "data": { "kind": "QueryGroup", "spec": { "queries": [{ "kind": "PanelQuery", "spec": { "hidden": false, "query": { "datasource": { "name": "afmykralbnj7kf" }, "group": "grafana-postgresql-datasource", "kind": "DataQuery", "spec": { "dataset": "sensors_db", "editorMode": "code", "format": "time_series", "rawQuery": true, "rawSql": "WITH sisgeo AS ( SELECT m.\"timestamp\" AS \"time\", item.device->>'device_index' AS device_index, NULLIF(item.device->>'value1','')::double precision AS value1, NULLIF(item.device->>'value2','')::double precision AS value2 FROM public.multiconnect AS m CROSS JOIN LATERAL jsonb_array_elements(COALESCE(m.lora_sisgeo_devices, '[]'::jsonb)) AS item(device) WHERE $__timeFilter(m.\"timestamp\") AND m.controller_id = ${controller_id:sqlstring} ) SELECT \"time\", 'SISGEO ' || device_index || ' Value 1' AS \"metric\", value1 AS \"value\" FROM sisgeo WHERE value1 IS NOT NULL UNION ALL SELECT \"time\", 'SISGEO ' || device_index || ' Value 2' AS \"metric\", value2 AS \"value\" FROM sisgeo WHERE value2 IS NOT NULL ORDER BY \"time\";" }, "version": "v0" }, "refId": "A" } }], "queryOptions": {}, "transformations": [] } }, "description": "", "id": 4, "links": [], "title": "SISGEO values", "vizConfig": { "group": "timeseries", "kind": "VizConfig", "spec": { "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "auto", "spanNulls": true }, "decimals": 3, "unit": "none" }, "overrides": [] }, "options": { "legend": { "calcs": ["lastNotNull", "min", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } }, "version": "13.0.1+security-01" } } },
    "panel-5": { "kind": "Panel", "spec": { "data": { "kind": "QueryGroup", "spec": { "queries": [{ "kind": "PanelQuery", "spec": { "hidden": false, "query": { "datasource": { "name": "afmykralbnj7kf" }, "group": "grafana-postgresql-datasource", "kind": "DataQuery", "spec": { "dataset": "sensors_db", "editorMode": "code", "format": "time_series", "rawQuery": true, "rawSql": "WITH sisgeo AS ( SELECT m.\"timestamp\" AS \"time\", item.device->>'device_index' AS device_index, NULLIF(item.device->>'temperature_c','')::double precision AS temperature_c, NULLIF(item.device->>'humidity_pct','')::double precision AS humidity_pct, NULLIF(item.device->>'supply_voltage_v','')::double precision AS supply_voltage_v FROM public.multiconnect AS m CROSS JOIN LATERAL jsonb_array_elements(COALESCE(m.lora_sisgeo_devices, '[]'::jsonb)) AS item(device) WHERE $__timeFilter(m.\"timestamp\") AND m.controller_id = ${controller_id:sqlstring} ) SELECT \"time\", 'SISGEO ' || device_index || ' Temperature C' AS \"metric\", temperature_c AS \"value\" FROM sisgeo WHERE temperature_c IS NOT NULL UNION ALL SELECT \"time\", 'SISGEO ' || device_index || ' Humidity %RH' AS \"metric\", humidity_pct AS \"value\" FROM sisgeo WHERE humidity_pct IS NOT NULL UNION ALL SELECT \"time\", 'SISGEO ' || device_index || ' Supply V' AS \"metric\", supply_voltage_v AS \"value\" FROM sisgeo WHERE supply_voltage_v IS NOT NULL ORDER BY \"time\";" }, "version": "v0" }, "refId": "A" } }], "queryOptions": {}, "transformations": [] } }, "description": "", "id": 5, "links": [], "title": "SISGEO environment and supply", "vizConfig": { "group": "timeseries", "kind": "VizConfig", "spec": { "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "auto", "spanNulls": true }, "decimals": 2, "unit": "none" }, "overrides": [] }, "options": { "legend": { "calcs": ["lastNotNull", "min", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } }, "version": "13.0.1+security-01" } } },
